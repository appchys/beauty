rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Desarrollo: permitir todo
    match /users/{userId} {
      allow read, write: if true;
    }

    match /businesses/{businessId} {
      allow read, write: if true;
    }

    match /loyaltyCards/{cardId} {
      allow read, write: if true;
    }

    match /clientCards/{clientCardId} {
      allow read, write: if true;
    }

    match /qrCodes/{qrCodeId} {
      allow read, write: if true;
    }

    match /stickerScans/{scanId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /courses/{courseId} {
      allow read, write: if true;
    }

    match /course_enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // Regla general para cualquier otra colección en desarrollo
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
